generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// المستخدم
// ═══════════════════════════════════════════
model User {
  id                 String   @id @default(cuid())
  email              String   @unique @db.VarChar(150)
  passwordHash       String   @db.VarChar(200)
  fullName           String   @db.VarChar(200)
  schoolName         String?  @db.VarChar(200)
  securityQuestion   String?  @db.VarChar(200)
  securityAnswerHash String?  @db.VarChar(200)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  classes       Class[]
  schedules     Schedule[]
  seatingCharts SeatingChart[]

  @@map("users")
}

// ═══════════════════════════════════════════
// القسم
// ═══════════════════════════════════════════
model Class {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  level     String   @db.VarChar(20)
  userId    String
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  students     Student[]
  notes        Note[]
  schedules    Schedule[]
  seatingChart SeatingChart?

  @@index([userId])
  @@map("classes")
}

// ═══════════════════════════════════════════
// التلميذ
// ═══════════════════════════════════════════
model Student {
  id            Int      @id @default(autoincrement())
  fullName      String   @db.VarChar(200)
  classId       Int
  photoUrl      String?  @db.Text
  guardianName  String?  @db.VarChar(200)
  guardianPhone String?  @db.VarChar(30)
  createdAt     DateTime @default(now())

  class      Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendance Attendance[]
  grades     Grade[]
  notes      Note[]

  @@index([classId])
  @@map("students")
}

// ═══════════════════════════════════════════
// الحضور
// ═══════════════════════════════════════════
model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  date      DateTime @db.Date
  period    String   @db.VarChar(20)
  status    String   @db.VarChar(20)
  createdAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, period])
  @@index([date])
  @@map("attendance")
}

// ═══════════════════════════════════════════
// الدرجات
// ═══════════════════════════════════════════
model Grade {
  id         Int      @id @default(autoincrement())
  studentId  Int
  classId    Int
  assessment String   @db.VarChar(50)
  score      Float
  maxScore   Float    @default(20)
  coeff      Int      @default(1)
  date       DateTime @db.Date
  note       String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classId, date])
  @@map("grades")
}

// ═══════════════════════════════════════════
// الملاحظات
// ═══════════════════════════════════════════
model Note {
  id        Int      @id @default(autoincrement())
  classId   Int
  studentId Int?
  type      String   @db.VarChar(20)
  title     String   @db.VarChar(200)
  content   String   @db.VarChar(2000)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId, date])
  @@index([studentId])
  @@map("notes")
}

// ═══════════════════════════════════════════
// جدول الأسبوع
// ═══════════════════════════════════════════
model Schedule {
  id        Int      @id @default(autoincrement())
  userId    String
  classId   Int
  dayOfWeek Int
  startTime String   @db.VarChar(5)
  endTime   String   @db.VarChar(5)
  subject   String   @db.VarChar(100)
  room      String?  @db.VarChar(50)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
  @@map("schedule")
}

// ═══════════════════════════════════════════
// مخطط الجلوس
// ═══════════════════════════════════════════
model SeatingChart {
  id        Int      @id @default(autoincrement())
  classId   Int      @unique
  userId    String
  rows      Int      @default(5)
  cols      Int      @default(4)
  // seats: map من "row-col" → studentId
  // مثال: { "0-0": 5, "0-1": 8, "1-0": 3 }
  seats     Json     @default("{}")
  delegate1 Int?
  delegate2 Int?
  delegate3 Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seating_charts")
}